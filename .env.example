# Copy this file to .env in the Nexus folder and restart npm start.
# Keep .env private. Never paste keys into frontend code or GitHub.

# Free Standard key: https://account.heigit.org/
NEXUS_ORS_API_KEY=
# Your actual endpoints, in longitude,latitude order. No defaults are fabricated.
NEXUS_ROUTE_SCHOOL_START=
NEXUS_ROUTE_SCHOOL_END=
NEXUS_ROUTE_OFFICE_START=
NEXUS_ROUTE_OFFICE_END=

# A channel you have permission to read. No public channel is selected silently.
NEXUS_THINGSPEAK_CHANNEL_ID=
NEXUS_THINGSPEAK_FIELD=1
NEXUS_THINGSPEAK_UNIT=
# Optional for a private channel; only manager/staff/auditor may read it in NEXUS.
NEXUS_THINGSPEAK_READ_KEY=
NEXUS_THINGSPEAK_MAX_AGE_MINUTES=90

# Public weather, MET advisories, national electricity and river model need no key.
